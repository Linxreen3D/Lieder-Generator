# Kopie dieser Datei heißt ".env" (macht install.bat automatisch).

# Claude-API-Key für richtige Lyrics (optional, https://console.anthropic.com).
# Ohne Key läuft das Tool im Offline-Modus mit Textbausteinen.
ANTHROPIC_API_KEY=

# Nur diese Nischen im Tool anzeigen (kommagetrennt, leer = alle)
LIEDGEN_FOCUS=balkan_ballade,nordic_folk_pop,deutschrap_street,deutschrap_melodic
